import type { Component } from '@vesk/types';
import { Link } from '@vesk/runtime/router'

interface GuidesLayoutProps {
	children?: Component
}

const guideLinks = [
	{ label: 'guides home', href: '/portal/guides' },
	{ label: 'portal home', href: '/portal' },
]

async component GuidesLayout(props: GuidesLayoutProps) {
	<div class="guides-layout">
		<div class="guides-subnav flex items-center gap-4 border-b border-gray-100 px-5 py-2 font-mono text-[11px] text-gray-500">
			<span class="uppercase tracking-wider text-gray-400">Guides layout</span>
			for (const g of guideLinks) {
				<Link href={g.href} class="no-underline hover:text-black">{g.label}</Link>
			}
		</div>
		<div class="guides-slot">{props.children}</div>
	</div>
}
